{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build:vault",
    "watchPatterns": ["apps/vault/**", "packages/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run start:vault",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
