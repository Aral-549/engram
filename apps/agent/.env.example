# Copy to .env.assistant and .env.planner (both gitignored). Server-only unless prefixed NEXT_PUBLIC_.
AGENT_PERSONA=assistant            # assistant | planner
NEXT_DIST_DIR=.next-assistant
APP_ORIGIN=http://localhost:3201   # exact origin this app is served from (app sessions are bound to it)
AGENT_ID=0                         # ERC-8004 token id on Monad testnet
AGENT_MODE=disclosure             # disclosure (agents ask, the vault answers) | offline (key grants)
CONTINUATION_SECRET=              # disclosure mode: 32+ random chars, e.g. openssl rand -hex 32
AGENT_X25519_PRIVATE_KEY=0x...     # offline mode only
AGENT_OPERATOR_KEY=0x...           # offline mode only: pays gas for this agent's own writes
INDEXER_URL=http://localhost:8090/v1/graphql   # optional: without it, reads fall back to RPC logs
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=sk-...
KIMI_MODEL=kimi-k2.6                # or kimi-k3 (flagship)
NEXT_PUBLIC_VAULT_URL=http://localhost:3100
NEXT_PUBLIC_AGENT_ID=0
NEXT_PUBLIC_AGENT_PERSONA=assistant
NEXT_PUBLIC_AGENT_MODE=disclosure   # must match AGENT_MODE
